# Copy to a private env file on the Spark and fill every required value.
# Do not put VLLM_API_KEY here; keep it in a separate 0600 file.

SPARK_COMPOSE_PROJECT_NAME=minecraft-studio-ornith-heretic-canary
SPARK_CONTAINER_NAME=minecraft-studio-ornith-heretic-canary
SPARK_DEPLOYMENT_PROFILE=canary
SPARK_RESTART_POLICY=no

# Pin both values before starting. Use a registry @sha256 digest or, for an
# audited local build without RepoDigests, its immutable sha256 image ID. The
# model revision must be its exact Git commit SHA.
SPARK_VLLM_IMAGE=
SPARK_MODEL_REVISION=
SPARK_MODEL_PATH=
SPARK_CACHE_PATH=
SPARK_API_KEY_ENV_FILE=

# Bind to 127.0.0.1 until the Spark interface has been verified.  Set this to
# the actual trusted U9/LAN address only after checking `ip addr` on the Spark.
SPARK_BIND_ADDRESS=127.0.0.1
SPARK_HOST_PORT=8001
SPARK_SERVED_MODEL_NAME=ornith15-heretic

SPARK_MAX_MODEL_LEN=262144
SPARK_MAX_NUM_SEQS=16
SPARK_MAX_NUM_BATCHED_TOKENS=32768
SPARK_GPU_MEMORY_UTILIZATION=0.85
SPARK_KV_CACHE_DTYPE=fp8
SPARK_REASONING_PARSER=qwen3
SPARK_TOOL_CALL_PARSER=qwen3_xml
SPARK_SAFETENSORS_LOAD_STRATEGY=prefetch
# The pinned runtime was verified to load Qwen3_5MoeMTP and emit positive
# speculative draft-token counters even though the index has no mtp.* prefix.
SPARK_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":2}'
SPARK_MTP_EXPECTED=true
SPARK_LIMIT_MM_PER_PROMPT='{"image":1,"video":0}'

SPARK_SHM_SIZE=16gb
SPARK_STOP_GRACE_PERIOD=90s
SPARK_LOG_MAX_SIZE=50m
SPARK_LOG_MAX_FILES=5
VLLM_LOGGING_LEVEL=INFO
