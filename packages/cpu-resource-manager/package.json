{
  "name": "@minecraft-studio/cpu-resource-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:node": "pnpm build && node --test tests/node-smoke.node-test.mjs",
    "benchmark": "pnpm build && node ../../scripts/benchmark-cpu-resource-manager.mjs",
    "profile": "node dist/cli.js"
  }
}
