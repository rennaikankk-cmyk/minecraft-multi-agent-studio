# Production profile template.  Keep this separate from the 0.85 canary file.
# Copy to a private env file, fill immutable values, and use a separate 0600
# API-key file referenced by SPARK_API_KEY_ENV_FILE.

SPARK_COMPOSE_PROJECT_NAME=minecraft-studio-ornith-heretic-production
SPARK_CONTAINER_NAME=minecraft-studio-ornith-heretic-production
SPARK_DEPLOYMENT_PROFILE=production
SPARK_RESTART_POLICY=unless-stopped
SPARK_VLLM_IMAGE=
SPARK_MODEL_REVISION=
SPARK_MODEL_PATH=
SPARK_CACHE_PATH=
SPARK_API_KEY_ENV_FILE=

# Production should bind only to an address verified on the Spark and allowed
# by the local firewall.  The example remains loopback until that is confirmed.
SPARK_BIND_ADDRESS=127.0.0.1
SPARK_HOST_PORT=8000
SPARK_SERVED_MODEL_NAME=ornith15-heretic

SPARK_MAX_MODEL_LEN=262144
SPARK_MAX_NUM_SEQS=16
SPARK_MAX_NUM_BATCHED_TOKENS=65536
SPARK_GPU_MEMORY_UTILIZATION=0.90
SPARK_KV_CACHE_DTYPE=fp8
SPARK_REASONING_PARSER=qwen3
SPARK_TOOL_CALL_PARSER=qwen3_xml
SPARK_SAFETENSORS_LOAD_STRATEGY=prefetch
SPARK_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":2}'
SPARK_MTP_EXPECTED=true
SPARK_LIMIT_MM_PER_PROMPT='{"image":1,"video":0}'

SPARK_SHM_SIZE=16gb
SPARK_STOP_GRACE_PERIOD=90s
SPARK_LOG_MAX_SIZE=50m
SPARK_LOG_MAX_FILES=5
VLLM_LOGGING_LEVEL=INFO
