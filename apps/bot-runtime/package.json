{
  "name": "@minecraft-studio/bot-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:supervisor": "node dist/supervisor-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm build && node --test tests/supervisor-process.node-test.mjs",
    "test:supervisor": "pnpm build && node --test tests/supervisor-process.node-test.mjs",
    "benchmark:supervisor": "pnpm build && node ../../scripts/benchmark-bot-supervisor.mjs",
    "test:integration": "vitest run tests/real-isolated-server.integration.test.ts"
  },
  "dependencies": {
    "@minecraft-studio/cpu-resource-manager": "workspace:*",
    "@minecraft-studio/observability": "workspace:*",
    "@minecraft-studio/protocol": "workspace:*",
    "@minecraft-studio/safety": "workspace:*",
    "@minecraft-studio/skills": "workspace:*",
    "mineflayer": "4.37.1",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-tool": "1.2.0",
    "vec3": "0.1.10",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "minecraft-protocol": "1.66.2"
  }
}
