AI_QUANTIZATION=modelopt_fp4
VLLM_HOST=SPARK_PRIVATE_IP
VLLM_PORT=8000
# REQUIRED: create outside Git and copy the same value to the U9 profile.
VLLM_API_KEY=
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=4
VLLM_ENABLE_PER_REQUEST_METRICS=true
