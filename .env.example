# standard | docker | portable | netcafe
STUDIO_MODE=standard

# 便携模式的数据根目录。不要指向系统目录。
STUDIO_PORTABLE_ROOT=

# 网吧模式使用的临时会话目录。后续模块将实现安全清理。
STUDIO_NETCAFE_SESSION_ROOT=

# 仅用于未来的服务端 Local AI Hub 适配，不得使用 NEXT_PUBLIC_ 前缀。
LOCAL_AI_HUB_URL=

# 单 Bot Runtime 只接受 purpose=isolated-test 的本机或私有局域网配置。
BOT_SERVER_PROFILE_PATH=

# Coordinator Runtime Link 仅允许监听本机回环地址。peers JSON 只保存
# 每个 Bot 共享密钥的 SHA-256，不保存明文密钥。严格形状示例：
# [{"keyId":"runtime-key-01","botId":"studio-bot-01","secretSha256":"<64位小写十六进制>"}]
# keyId 和 botId 必须唯一，且一个 botId 只能绑定一个 peer。
COORDINATOR_RUNTIME_LINK_HOST=127.0.0.1
COORDINATOR_RUNTIME_LINK_PORT=3220
COORDINATOR_RUNTIME_LINK_PEERS_JSON=

# Bot Runtime 只连接固定的本机 Runtime Link 路径。明文共享密钥只放在
# Runtime 进程环境变量，不得提交真实值。
BOT_RUNTIME_LINK_URL=ws://127.0.0.1:3220/v1/runtime-link
BOT_RUNTIME_LINK_KEY_ID=
BOT_RUNTIME_LINK_SECRET=

# Control API 当前只允许绑定 127.0.0.1 或 ::1。
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3210

# JSON 数组，仅保存令牌 SHA-256，不保存明文令牌。留空时 Control API 拒绝启动。
CONTROL_API_AUTH_JSON=

# Dashboard 服务端代理只允许连接本机 Control API。明文令牌只放在服务端环境变量，
# 不得使用 NEXT_PUBLIC_ 前缀，也不得提交真实值。
DASHBOARD_CONTROL_API_URL=http://127.0.0.1:3210
DASHBOARD_CONTROL_API_TOKEN=

# 可选：本地停止确认码的 SHA-256。只保存哈希，不保存确认码明文。
# 未配置时 Dashboard 安全停止按钮保持禁用。
DASHBOARD_STOP_CONFIRMATION_SHA256=

# 仅供 P1.3.1 隔离 PostgreSQL/Redis 集成测试使用。必须指向本机回环地址，
# 使用专用测试数据库和 Redis 命名空间；默认留空，生产启动不读取这些值。
TASK_POSTGRES_URL=
TASK_REDIS_URL=
TASK_INFRA_TEST_NAMESPACE=
