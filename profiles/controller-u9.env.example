# U9 CONTROLLER ROLE — fill the verified wired Spark address on arrival.
STUDIO_NODE_ROLE=controller
AI_PROVIDER=openai-compatible
AI_PROVIDER_NAME=spark-vllm
AI_BASE_URL=http://SPARK_PRIVATE_IP:8000/v1
SPARK_AI_BASE_URL=http://SPARK_PRIVATE_IP:8000/v1
SPARK_AI_NODE_NAME=MSI DGX Spark
SPARK_AI_BACKEND=vllm
AI_MODEL=qwen3.8-27b-nvfp4
AI_QUANTIZATION=modelopt_fp4
SPARK_AI_QUANTIZATION=modelopt_fp4
# REQUIRED before enabling the remote Spark connection; use the same vLLM key.
AI_API_KEY=
SPARK_AI_API_KEY=
COORDINATOR_AI_ENABLED=true
AI_MAX_CONCURRENCY=4
AI_MAX_QUEUE=64
AI_PER_BOT_CONCURRENCY=1
# REQUIRED on U9 after applying the checked-in pgvector migration. Keep the
# credential-bearing URL outside Git and bind PostgreSQL to loopback only.
WORLD_MEMORY_ENABLED=true
WORLD_MEMORY_POSTGRES_URL=
WORLD_MEMORY_SCHEMA=public
WORLD_MEMORY_MAX_ENTRIES=12
WORLD_MEMORY_RADIUS=4096
WORLD_MEMORY_MIN_CONFIDENCE=0.2
# REQUIRED: dedicated persistent local directory owned only by the Coordinator
# service identity. Never use Temp, a network share, repository root or Spark.
WORLD_MEMORY_INGESTION_SPOOL_DIR=C:\ProgramData\MinecraftMultiAgentStudio\world-memory-ingestion
WORLD_MEMORY_INGESTION_BATCH_SIZE=25
WORLD_MEMORY_INGESTION_MAX_PENDING_BATCHES=10000
WORLD_MEMORY_INGESTION_POLL_INTERVAL_MS=1000
WORLD_MEMORY_INGESTION_RETRY_BASE_MS=250
WORLD_MEMORY_INGESTION_RETRY_MAX_MS=60000
CONTROL_API_HOST=127.0.0.1
COORDINATOR_RUNTIME_LINK_HOST=127.0.0.1
COORDINATOR_CONTROL_LINK_HOST=127.0.0.1
CPU_AFFINITY_ENABLED=false
CPU_SCHEDULER_ENABLED=false
