{
  "name": "@minecraft-studio/ai-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:vllm": "tsx src/test-vllm.ts"
  },
  "dependencies": {
    "@minecraft-studio/observability": "workspace:*",
    "@minecraft-studio/protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
