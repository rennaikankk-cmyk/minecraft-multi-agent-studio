# standard | docker | portable | netcafe
# 启动意图（normal=默认，不启动本地 MC Server | local_test | e2e）
STUDIO_MODE=normal
# 部署形态（旧 STUDIO_MODE 的取值迁移到这里；旧值在 STUDIO_MODE 中会带警告映射）
STUDIO_DEPLOYMENT_MODE=standard

# Real-server Bot slot ceiling. The launcher accepts 1-16 and defaults to 16.
STUDIO_MAX_BOTS=16

# 便携模式的数据根目录。不要指向系统目录。
STUDIO_PORTABLE_ROOT=

# 网吧模式使用的临时会话目录。后续模块将实现安全清理。
STUDIO_NETCAFE_SESSION_ROOT=
STUDIO_DASHBOARD_PORT=3000
STUDIO_MANAGER_PORT=3230

# Leave LOCAL_AI_HUB_URL and LOCAL_AI_MODEL empty for the desktop launcher to
# discover the currently running Spark service and model from these endpoints.
# LOCAL_AI_MODEL may be set as an optional model preference during discovery.
STUDIO_SPARK_AUTO_DISCOVERY=1
STUDIO_SPARK_HOSTS=192.168.100.2,dgx-spark.local,spark.local,127.0.0.1
STUDIO_SPARK_PORTS=18100,18102,8000,8001,11434,11435
# Startup-only retry window for a Spark service that is still booting.
STUDIO_SPARK_STARTUP_WAIT_MS=15000

# With Local AI connected, idle healthy Bots receive bounded survival work
# automatically. Set to 0 when every goal must come from the Dashboard.
STUDIO_AUTONOMY_ENABLED=1
STUDIO_AUTONOMY_INTERVAL_MS=15000
STUDIO_AUTONOMY_GOAL_TIMEOUT_MS=120000
STUDIO_AUTONOMY_FAILURE_COOLDOWN_MS=30000
STUDIO_AUTONOMY_TERMINAL_RETENTION_MS=15000

# Coordinator 服务端 Local AI Hub 配置，不得使用 NEXT_PUBLIC_ 前缀；
# 正常通过 pnpm start 启动时由上面的 Spark 自动发现结果注入。单独启动
# Coordinator 时才需要同时配置 URL 和模型，否则 Planner 保持关闭并 fail-closed。
# URL 只能是经批准的 HTTP(S) origin，不要写入凭据、路径、查询参数或片段。
LOCAL_AI_PROVIDER=vllm
LOCAL_AI_HUB_URL=
LOCAL_AI_MODEL=
# Optional bearer token for an authenticated OpenAI-compatible vLLM endpoint.
# Keep the real value in .env.local or the process environment; never commit it.
LOCAL_AI_API_KEY=
# Optional private env file containing LOCAL_AI_API_KEY or VLLM_API_KEY. Relative
# paths resolve beside the desktop executable (or the repository in dev mode).
LOCAL_AI_API_KEY_FILE=

# U9 上的统一 AI 请求调度。全局并发覆盖所有 Bot，不得超过 Spark 服务的
# max-num-seqs（当前部署为 16）。
AI_MAX_CONCURRENCY=12
AI_MAX_QUEUE=64
AI_PER_BOT_CONCURRENCY=1
AI_REQUEST_TIMEOUT_MS=120000

# 正常桌面启动请保持为空：Dashboard 创建的真实服 Bot 由 Studio Local Manager
# 在 runtime-data/bots 下生成 Profile 并独立启动。只有手工运行 pnpm bot:start
# 进行隔离服验收时才设置这个单 Bot Profile 路径。
BOT_SERVER_PROFILE_PATH=

# Coordinator Runtime Link 仅允许监听本机回环地址。peers JSON 只保存
# 每个 Bot 共享密钥的 SHA-256，不保存明文密钥。摘要是等价认证密钥，
# 必须按明文密钥同等级保护。严格形状示例：
# [{"keyId":"runtime-key-01","botId":"studio-bot-01","secretSha256":"<64位小写十六进制>"}]
# keyId 和 botId 必须唯一，且一个 botId 只能绑定一个 peer。
COORDINATOR_RUNTIME_LINK_HOST=127.0.0.1
COORDINATOR_RUNTIME_LINK_PORT=3220
COORDINATOR_RUNTIME_LINK_PEERS_JSON=
COORDINATOR_BOT_STALE_AFTER_MS=15000

# Bot Runtime 只连接固定的本机 Runtime Link 路径。明文共享密钥只放在
# Runtime 进程环境变量，不得提交真实值。
BOT_RUNTIME_LINK_URL=ws://127.0.0.1:3220/v1/runtime-link
BOT_RUNTIME_LINK_KEY_ID=
BOT_RUNTIME_LINK_SECRET=

# CPU Resource Manager 第一阶段：在目标主机 OFF/ON 实测通过前保持关闭。
CPU_RESOURCE_MANAGER_ENABLED=false
CPU_RESOURCE_MANAGER_MODE=auto
CPU_AFFINITY_ENABLED=false
CPU_SCHEDULER_ENABLED=false
CPU_SCHEDULER_INTERVAL_MS=2000
CPU_REBALANCE_COOLDOWN_MS=10000
CPU_MINIMUM_RESIDENCY_MS=30000
CPU_DEMOTION_DELAY_MS=30000
CPU_PRIORITY_COMBAT=realtime
CPU_PRIORITY_CRYSTAL_PVP=critical
CPU_PRIORITY_ESCAPE=critical
CPU_PRIORITY_PATHFINDING=high
CPU_PRIORITY_MINING=normal
CPU_PRIORITY_CHAT=low
CPU_PRIORITY_IDLE=background

# 手动模式必须显式开启。CPU ID 必须在线、位于当前 cpuset、非空且互不重叠；
# 输入无效时进入普通 CPU 回退，禁止猜测核心类型。
CPU_MANUAL_PERFORMANCE_CPUS=
CPU_MANUAL_EFFICIENCY_CPUS=

BOT_RUNTIME_PROCESS_MODE=process
BOT_RUNTIME_BOTS_PER_PROCESS=2
BOT_RUNTIME_AUTO_SIZE=true

# Bot Process Supervisor 是显式的多进程回滚/托管入口；正常 Dashboard 多 Bot
# 创建仍由 Studio Local Manager 管理。配置文件只引用密钥环境变量名，不保存明文密钥。
# ServerProfile 必须位于显式根目录内；符号链接逃逸会被拒绝。
BOT_SUPERVISOR_CONFIG_PATH=
BOT_SUPERVISOR_PROFILE_ROOT=
BOT_RUNTIME_LINK_SECRET_STUDIO_BOT_01=

# Coordinator Control Link 仅允许监听本机回环地址。clients JSON 只保存
# Control API 共享密钥的 SHA-256，不保存明文密钥。摘要是等价认证密钥，
# 必须按明文密钥同等级保护。严格形状示例：
# [{"clientId":"local-control-api","keyId":"control-api-key-01","secretSha256":"<64位小写十六进制>","capabilities":["bot.read","bot.stop","goal.submit","task.read"]}]
# clientId、keyId 和 secretSha256 必须各自唯一；goal.submit 或 task.read 未配置时，
# 对应的目标入口或持久任务历史保持禁用。
COORDINATOR_CONTROL_LINK_HOST=127.0.0.1
COORDINATOR_CONTROL_LINK_PORT=3221
COORDINATOR_CONTROL_LINK_CLIENTS_JSON=

# Control API 当前只允许绑定 127.0.0.1 或 ::1。
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3210
CONTROL_API_REQUESTS_PER_MINUTE=120
CONTROL_API_HANDSHAKES_PER_MINUTE=30
CONTROL_API_MAX_CONNECTIONS=5

# JSON 数组，仅保存令牌 SHA-256，不保存明文令牌。严格形状示例：
# [{"subject":"local-dashboard","tokenSha256":"<64位小写十六进制>","permissions":["bot.read","bot.position.read","bot.stop","goal.submit","task.read"]}]
# 留空时 Control API 拒绝启动。
CONTROL_API_AUTH_JSON=

# Control API 只连接固定的本机 Control Link 路径。明文共享密钥只放在
# Control API 进程环境变量；它的 SHA-256 必须与 Coordinator clients JSON 中的占位对应。
CONTROL_API_COORDINATOR_LINK_URL=ws://127.0.0.1:3221/v1/control-link
CONTROL_API_COORDINATOR_LINK_CLIENT_ID=local-control-api
CONTROL_API_COORDINATOR_LINK_KEY_ID=control-api-key-01
CONTROL_API_COORDINATOR_LINK_SECRET=

# Dashboard 服务端代理只允许连接本机 Control API。明文令牌只放在服务端环境变量，
# 不得使用 NEXT_PUBLIC_ 前缀，也不得提交真实值。
DASHBOARD_CONTROL_API_URL=http://127.0.0.1:3210
DASHBOARD_CONTROL_API_TOKEN=

# 可选：本地停止确认码的 SHA-256。只保存哈希，不保存确认码明文。
# 未配置时 Dashboard 安全停止按钮保持禁用。
DASHBOARD_STOP_CONFIRMATION_SHA256=

# Coordinator 的永久任务事实源。普通启动不会创建数据库或自动执行迁移；必须先由人工
# 按顺序应用 packages/task-system/migrations/0001..0006。URL 留空时持久任务历史明确
# 显示不可用；配置 Local AI 目标执行但未配置该 URL 时 Coordinator fail-closed 拒绝启动。
COORDINATOR_TASK_POSTGRES_URL=
# URL 留空时这里必须同样留空：配置 schema 却没有 URL 会让 Coordinator 直接拒绝启动。
# 留空时按 public 处理；只有填入 URL 后才需要显式指定非 public 的 schema。
COORDINATOR_TASK_POSTGRES_SCHEMA=

# Coordinator -> BullMQ 投递。生产竖切必须显式设置为 production；本地基础设施
# 仍必须使用 loopback PostgreSQL/Redis。isolated-test 保留给基础设施验收。
# 留空时保持原有同步执行路径，作为显式回滚开关。
COORDINATOR_TASK_DELIVERY=
COORDINATOR_TASK_REDIS_URL=
# 留空时使用 studio_tasks_v1。
COORDINATOR_TASK_QUEUE_NAME=
COORDINATOR_TASK_QUEUE_PREFIX=
# 以下投递参数留空时使用代码内的有界默认值。
COORDINATOR_TASK_DELIVERY_INSTANCE_ID=
COORDINATOR_TASK_OUTBOX_BATCH_SIZE=
COORDINATOR_TASK_OUTBOX_CLAIM_TTL_MS=
COORDINATOR_TASK_OUTBOX_POLL_INTERVAL_MS=
COORDINATOR_TASK_OUTBOX_RETRY_BASE_MS=
COORDINATOR_TASK_OUTBOX_RETRY_MAX_MS=
# production profile 的 Worker -> Coordinator 执行桥，只允许显式回环绑定。
# start-studio 会为本机进程组派生共享密钥；单独启动服务时必须显式提供 32+ 字符。
COORDINATOR_TASK_EXECUTION_HOST=
COORDINATOR_TASK_EXECUTION_PORT=
COORDINATOR_TASK_EXECUTION_SECRET=

# 仅供 P1.3 隔离 PostgreSQL/Redis 集成测试使用。必须指向本机回环地址，
# 使用专用测试数据库和 Redis 命名空间；默认留空，生产启动不读取这些值。
TASK_POSTGRES_URL=
TASK_REDIS_URL=
TASK_INFRA_TEST_NAMESPACE=

# 独立 Task Worker profile。隔离验收使用下面的默认组合；生产使用
# production + coordinator-goal，且必须与上面的 Coordinator 队列/执行桥配置一致。
TASK_WORKER_PURPOSE=isolated-test
TASK_WORKER_HANDLER_PROFILE=isolated-acceptance
TASK_QUEUE_NAME=studio_tasks_v1
TASK_WORKER_CONCURRENCY=1
TASK_WORKER_LEASE_DURATION_MS=5000
TASK_WORKER_RENEW_INTERVAL_MS=1000
TASK_WORKER_LOCK_DURATION_MS=10000
TASK_WORKER_STALLED_INTERVAL_MS=2000
TASK_WORKER_CANCELLATION_WAIT_MS=10000
TASK_WORKER_CANCELLATION_POLL_INTERVAL_MS=100

# 可选：Coordinator 闭环 Goal FSM 的 PostgreSQL 永久存储。数据库必须已经应用
# packages/task-system/migrations/0001..0006；留空时会明确降级为仅进程内状态。
COORDINATOR_TASK_POSTGRES_URL=
COORDINATOR_TASK_POSTGRES_SCHEMA=public

# 可选的本机开发/验收设置；不包含凭据。
STUDIO_SMOKE_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_BROWSER_CHANNEL=msedge
PLAYWRIGHT_PORT=3000

# Optional DGX Spark Heretic deployment inputs. These are non-secret references
# only; keep the actual API key in the 0600 file referenced by
# SPARK_API_KEY_ENV_FILE. The complete profile templates live under
# configs/spark/ and are passed to Docker Compose explicitly on the Spark.
SPARK_VLLM_IMAGE=
SPARK_MODEL_REVISION=
SPARK_MODEL_PATH=
SPARK_CACHE_PATH=
SPARK_API_KEY_ENV_FILE=
SPARK_BIND_ADDRESS=127.0.0.1
SPARK_HOST_PORT=8001
SPARK_SERVED_MODEL_NAME=ornith15-heretic
SPARK_DEPLOYMENT_PROFILE=canary
SPARK_GPU_MEMORY_UTILIZATION=0.85
SPARK_MAX_MODEL_LEN=262144
SPARK_MAX_NUM_SEQS=16
SPARK_MAX_NUM_BATCHED_TOKENS=32768
SPARK_KV_CACHE_DTYPE=fp8
SPARK_SAFETENSORS_LOAD_STRATEGY=prefetch
SPARK_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":2}'
SPARK_MTP_EXPECTED=true
SPARK_LIMIT_MM_PER_PROMPT='{"image":1,"video":0}'
