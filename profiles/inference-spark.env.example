# SPARK INFERENCE ROLE — no Coordinator, Bot, database, or Dashboard services.
STUDIO_NODE_ROLE=inference
AI_MODEL_ROOT=/home/rennaikank/models
AI_CACHE_ROOT=/home/rennaikank/ai-cache
HF_HOME=/home/rennaikank/ai-cache/huggingface
VLLM_CACHE_ROOT=/home/rennaikank/ai-cache/vllm
XDG_CACHE_HOME=/home/rennaikank/ai-cache/xdg
CUDA_CACHE_PATH=/home/rennaikank/ai-cache/cuda
FLASHINFER_WORKSPACE_BASE=/home/rennaikank/ai-cache/flashinfer
AI_MODEL_PATH=/home/rennaikank/models/qwen3.8-27b-nvfp4
