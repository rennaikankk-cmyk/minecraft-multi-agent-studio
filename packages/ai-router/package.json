{
  "name": "@minecraft-studio/ai-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "endpoint": "pnpm build && node dist/ai-endpoint-cli.js",
    "benchmark": "pnpm build && node dist/benchmark-cli.js",
    "soak": "pnpm build && node dist/soak-cli.js"
  },
  "dependencies": {
    "@minecraft-studio/observability": "workspace:*",
    "@minecraft-studio/protocol": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
